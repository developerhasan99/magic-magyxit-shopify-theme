{% liquid
  # Products tagged 'own_gallery' use their own image, no marketing images (same as product-media-gallery)
  unless product.tags contains 'own_gallery'
    assign it_image = shop.metaobjects['marketing_images']['italian'].images.value
    assign es_image = shop.metaobjects['marketing_images']['spanish'].images.value
    assign pt_image = shop.metaobjects['marketing_images']['portuguese'].images.value
    assign fr_image = shop.metaobjects['marketing_images']['france'].images.value
    assign de_image = shop.metaobjects['marketing_images']['german'].images.value
    assign en_image = shop.metaobjects['marketing_images']['english'].images.value
  endunless

  assign breakdown_image = blank
  for item in it_image limit: 1
    assign breakdown_image = item
  endfor
  if breakdown_image == blank
    assign breakdown_image = product.images[1]
  endif
%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="{{ section.id }}"
  class="section-{{ section.id }}-padding"
  style="background-color: {{ section.settings.background_color }}">
  <div class="page-width">
    <div class="grid md:grid-cols-2 gap-8">
      <div>
        {% if breakdown_image %}
          <img
            id="scent-breakdown-img-{{ section.id }}"
            class="w-full h-full rounded-lg object-cover"
            src="{{ breakdown_image | image_url: width: 1080 }}"
            alt="Scent Breakdown"
            height="{{ breakdown_image.height }}"
            width="{{ breakdown_image.width }}">
        {% endif %}
      </div>
      <div>
        <div class="bg-[#f2f2f2] px-4 py-6 rounded-lg !mb-4">
          <h2 class="m-0 mb-3 text-2xl tracking-normal font-semibold text-center">Fragrance Composition</h2>
          <div class="[&_p]:last:mb-0 [&_p]:leading-snug [&_p]:tracking-normal text-center">
            {{ product.metafields.custom.scent_breakdown | metafield_tag }}
          </div>
        </div>
        <div class="bg-white p-4 rounded-lg grid grid-cols-3 gap-4 !mb-3">
          <div>
            <h3 class="m-0 tracking-normal font-semibold">
              Top Notes
            </h3>
          </div>
          <div class="col-span-2">
            <h4 class="m-0 pb-2 border-0 border-b border-solid border-gray-300">{{ product.metafields.custom.top_notes.value.heading }}</h4>
            <p class="mb-0 mt-2 tracking-normal text-[#888888] leading-snug text-sm">{{ product.metafields.custom.top_notes.value.description | metafield_text }}</p>
          </div>
        </div>
        <div class="bg-white p-4 rounded-lg grid grid-cols-3 gap-4 !mb-3">
          <div>
            <h3 class="m-0 tracking-normal font-semibold">
              Middle Notes
            </h3>
          </div>
          <div class="col-span-2">
            <h4 class="m-0 pb-2 border-0 border-b border-solid border-gray-300">{{ product.metafields.custom.middle_notes.value.heading }}</h4>
            <p class="mb-0 mt-2 tracking-normal text-[#888888] leading-snug text-sm">{{ product.metafields.custom.middle_notes.value.description | metafield_text }}</p>
          </div>
        </div>
        <div class="bg-white p-4 rounded-lg grid grid-cols-3 gap-4 !mb-0">
          <div>
            <h3 class="m-0 tracking-normal font-semibold">
              Base Notes
            </h3>
          </div>
          <div class="col-span-2">
            <h4 class="m-0 pb-2 border-0 border-b border-solid border-gray-300">{{ product.metafields.custom.base_notes.value.heading }}</h4>
            <p class="mb-0 mt-2 tracking-normal text-[#888888] leading-snug text-sm">{{ product.metafields.custom.base_notes.value.description | metafield_text }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% if it_image %}
  <script>
    (function () {
      // Scent breakdown image per Weglot language (falls back to Italian)
      var localImages = {
        it: {{ it_image | image_url: width: 1080 | json }},
        es: {{ es_image | image_url: width: 1080 | json }},
        pt: {{ pt_image | image_url: width: 1080 | json }},
        fr: {{ fr_image | image_url: width: 1080 | json }},
        de: {{ de_image | image_url: width: 1080 | json }},
        en: {{ en_image | image_url: width: 1080 | json }}
      };

      function changeLocalImage(newLang) {
        var img = document.getElementById('scent-breakdown-img-{{ section.id }}');
        if (img) img.src = localImages[newLang] || localImages.it;
      }

      function init() {
        if (!window.Weglot) return;
        if (typeof Weglot.getCurrentLang === 'function' && Weglot.getCurrentLang()) {
          changeLocalImage(Weglot.getCurrentLang());
        }
        Weglot.on('initialized', function () { changeLocalImage(Weglot.getCurrentLang()); });
        Weglot.on('languageChanged', changeLocalImage);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
{% endif %}

{% schema %}
  {
    "name": "Scent Breakdown",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#fcfbf9"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Section Image"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Scent Breakdown"
      }
    ]
  }
{% endschema %}